rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0
        && (!('photoUrl' in data) || data.photoUrl is string)
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRide(data) {
      return data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 12
        && data.leaderId is string
        && data.status in ['CREATED', 'LOBBY', 'ACTIVE', 'COMPLETED', 'CANCELLED']
        && data.startLocationName is string
        && data.destinationName is string
        && data.startLat is number
        && data.startLng is number
        && data.destLat is number
        && data.destLng is number
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidRider(data) {
      return data.id is string
        && data.userId is string
        && data.rideId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('motorcycleModel' in data) || (data.motorcycleModel is string && data.motorcycleModel.size() <= 100))
        && data.role in ['LEADER', 'MEMBER']
        && data.status in ['RIDING', 'STOPPED', 'EMERGENCY', 'OFFLINE']
        && data.latitude is number
        && data.longitude is number;
    }

    function isValidQuickMessage(data) {
      return data.id is string
        && data.rideId is string
        && data.senderId is string
        && data.senderName is string
        && data.type is string
        && data.text is string && data.text.size() > 0 && data.text.size() <= 200;
    }

    function isValidSos(data) {
      return data.id is string
        && data.rideId is string
        && data.riderId is string
        && data.riderName is string
        && data.latitude is number
        && data.longitude is number
        && data.isResolved is bool;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Rides collection
    match /rides/{rideId} {
      // NOTE (Task 21): reads remain open for lobby/preview discovery by invite code
      // (see below for the exact change and why hardening is incremental).
      allow read: if true;

      // Create/delete unchanged: ride creation happens before the leader has any
      // member-side state, and delete is not exercised by the app.
      allow create, delete: if true;

      // Shared ride status is CANONICAL group lifecycle state (Task 21): moving a ride
      // between lifecycle states (CREATED/LOBBY/ACTIVE/COMPLETED/CANCELLED) is
      // leader-only. Non-status field updates (distance telemetry, leader transfer
      // inside the same doc) keep working for any authenticated rider; the ride leader
      // check uses the server-side document's leaderId, not client-supplied data.
      allow update: if (!('status' in request.resource.data)
            || request.resource.data.status == resource.data.status
            || (request.resource.data.status in ['ACTIVE', 'COMPLETED', 'CANCELLED']
                && request.auth != null
                && request.auth.uid == resource.data.leaderId));

      // Riders subcollection
      match /riders/{riderId} {
        allow read, write: if true;
      }

      // Quick Messages subcollection (Task 21): sender identity must match the
      // authenticated user — a client cannot spoof another rider's senderId. The app
      // already sets senderId from the Firebase auth uid in sendQuickMessage().
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      // SOS Events subcollection
      match /sos/{sosId} {
        allow read, write: if true;
      }
    }
  }
}
